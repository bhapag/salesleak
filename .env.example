# SalesLeak — environment variables
# Copy this file to .env (local dev) and fill in real values.
# Never commit .env — only .env.example is tracked in git.

# ---------- Database (required) ----------
# PostgreSQL. In Supabase: Project Settings -> Database -> Connection string.
# DATABASE_URL: the POOLED connection (port 6543, "Transaction" mode / pgbouncer) —
#   used by the app at runtime, safe for serverless (many short-lived connections).
# DIRECT_URL: the DIRECT connection (port 5432) — used only for
#   `prisma migrate deploy` / `prisma migrate dev`, since the pooler doesn't
#   support the prepared statements migrations need.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ---------- Application URL (required in staging/production) ----------
# The public base URL of this deployment, no trailing slash. Used server-side
# to build absolute webhook/website-form URLs. On Vercel this can usually be
# left unset — VERCEL_URL is used automatically as a fallback. Set explicitly
# once you have a stable URL (staging or a future custom domain).
APP_URL="http://localhost:3000"

# ---------- AI provider (optional) ----------
# Unset -> every AI surface runs in clearly-labeled mock/dev mode. Set both to
# activate real Anthropic calls; no code change required either way.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# ---------- Ingestion (optional) ----------
# Off by default. See ARCHITECTURE.md's AI intelligence architecture section.
AI_INGESTION_ENRICHMENT="false"

# ---------- Managed by the platform, not set by hand ----------
# NODE_ENV        — "development" | "production", set by `next dev`/`next build`/host
# VERCEL_URL       — auto-set by Vercel to the deployment's own hostname
